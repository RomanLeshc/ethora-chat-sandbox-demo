# Production Ethora endpoints, read by ethora-chat-component's
# buildRuntimeHostConfig() to construct the XMPP service URL. Without these,
# `SERVICE` resolves to an empty string and @xmpp/client throws
# "No compatible connection method found" (nothing to match a transport
# against). See CLAUDE.md's canonical production endpoints.
VITE_XMPP_HOST=xmpp.chat.ethora.com
VITE_APP_XMPP_SERVICE=wss://xmpp.chat.ethora.com/ws
VITE_WIDGET_XMPP_CONFERENCE=conference.xmpp.chat.ethora.com
VITE_API=https://api.chat.ethora.com
VITE_WEB_DOMAIN=app.chat.ethora.com
