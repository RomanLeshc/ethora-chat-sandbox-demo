# From your Ethora app (app.chat.ethora.com -> app settings). Never ship the
# secret to the browser: it stays in the function's environment.
ETHORA_CHAT_APP_ID=your_app_id
ETHORA_CHAT_APP_SECRET=your_app_secret

# Optional
ETHORA_CHAT_API_URL=https://api.chat.ethora.com
ETHORA_XMPP_DEV_SERVER=wss://xmpp.chat.ethora.com/ws
DEMO_ROOM_ID=ethora-sandbox-demo-room
DEMO_ROOM_TITLE=Ethora sandbox demo
ALLOWED_ORIGIN=*
MAX_USERS_PER_HOUR=20
